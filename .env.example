# ------------------------------------------------------------------
# GMIU Attendance Dashboard — environment template
# Copy to .env (local) or set in the Vercel dashboard (Project → Settings
# → Environment Variables). NEVER commit the real .env.
# ------------------------------------------------------------------

# --- Database (Prisma / SQLite) -----------------------------------
# Local development (default, relative to the prisma/ folder):
DATABASE_URL="file:../db/custom.db"
# Vercel / serverless: the deployed filesystem is READ-ONLY outside /tmp,
# so point the database at a writable file there (data is ephemeral per
# instance — see DEPLOY.md for the honest trade-offs):
# DATABASE_URL="file:/tmp/custom.db"

# --- Encryption key (secrets at rest) -----------------------------
# Hex key encrypting the stored ERP credentials + notification configs.
# Priority (src/lib/crypto.ts): 1) APP_ENCRYPTION_KEY env, 2) db/encryption.key file.
# On Vercel ALWAYS use the env var (the file is not deployed with secrets).
# Generate: openssl rand -hex 32
# APP_ENCRYPTION_KEY=""

# --- Vercel Cron --------------------------------------------------
# When set, Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to
# /api/cron/sync (see vercel.crons.example.json). Generate:
# openssl rand -hex 24
# CRON_SECRET=""

# --- Notes ---------------------------------------------------------
# The ERP login itself (student ID + password) is NOT an environment
# variable: it is entered in the app's Settings tab and stored encrypted
# (AES-256-GCM) in the database using the key above.
