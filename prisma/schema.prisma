generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Key-value application settings (target %, sync interval, demo mode, ...)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Server-side ERP credentials. Secret is AES-256-GCM encrypted at rest.
model ErpConnection {
  id               String    @id @default(cuid())
  username         String
  secretEnc        String
  sessionCookieEnc String?
  status           String    @default("pending") // pending | connected | failed
  lastVerifiedAt   DateTime?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// Singleton sync state (id = "singleton")
model SyncState {
  id                  String    @id @default("singleton")
  status              String    @default("never_synced") // never_synced | idle | syncing | failed
  mode                String    @default("none") // none | live | demo
  lastSyncAt          DateTime?
  lastSuccessAt       DateTime?
  consecutiveFailures Int       @default(0)
  lastErrorCode       String?
  lastErrorMessage    String?
  nextScheduledSyncAt DateTime?
  updatedAt           DateTime  @updatedAt
}

// One row per sync attempt (audit / history)
model SyncLog {
  id           String    @id @default(cuid())
  status       String // running | success | failed | skipped
  trigger      String // scheduled | manual | startup
  mode         String // live | demo | none
  changes      Int       @default(0)
  durationMs   Int?
  summary      String?
  errorDetails String?
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
}

// Attendance subjects synced from ERP (or demo simulator)
model Subject {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  present   Int
  total     Int
  /** Semester partition (1–8) as reported by the ERP; null = not yet known. */
  semester  Int?
  active    Boolean  @default(true) // false = removed from ERP
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([semester])
}

// Detected changes between consecutive ERP snapshots
model ChangeEvent {
  id          String   @id @default(cuid())
  kind        String // ATTENDANCE_UPDATED | SUBJECT_ADDED | SUBJECT_REMOVED | REMINDER_UPSERTED | REMINDER_DATE_CHANGED | REMINDER_REMOVED
  subjectCode String?
  detail      String
  createdAt   DateTime @default(now())
}

// Reminders: ERP-generated (dedup via externalId) or user-created personal
model Reminder {
  id          String   @id @default(cuid())
  source      String // ERP | PERSONAL
  externalId  String?  @unique
  type        String // EXAM | PRACTICAL_EXAM | VIVA | ASSIGNMENT | SUBMISSION | ATTENDANCE_WARNING | OTHER
  title       String
  description String?
  // Optional subject link (subject.code). Attendance warnings set it from the
  // sync engine; personal reminders may pick one. null = general/no subject.
  subjectCode String?
  dueAt       DateTime
  status      String   @default("ACTIVE") // ACTIVE | DONE | DISMISSED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// In-app notifications generated by the sync engine
model Notification {
  id        String   @id @default(cuid())
  type      String // ATTENDANCE_WARNING | SYNC_FAILURE | SYNC_SUCCESS | ERP_CHANGE | REMINDER_CHANGE | SYSTEM
  title     String
  message   String
  severity  String   @default("info") // info | success | warning | critical
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Attendance trend history: one row per (subject, captured moment).
// subjectCode = "__overall__" stores the weighted overall figure.
model AttendanceSnapshot {
  id          String   @id @default(cuid())
  subjectCode String
  present     Int
  total       Int
  source      String // demo | live
  capturedAt  DateTime @default(now())

  @@index([subjectCode, capturedAt])
  @@index([capturedAt])
}

// Weekly class timetable. Seeded once by the demo ERP (source="demo");
// students can add/remove their own slots (source="personal").
model TimetableSlot {
  id          String @id @default(cuid())
  dayOfWeek   Int // 0 = Sunday ... 6 = Saturday
  startMin    Int // minutes from midnight, e.g. 630 for 10:30
  endMin      Int
  subjectCode String
  source      String @default("personal") // demo | personal

  @@index([dayOfWeek, startMin])
}

// Local-only overlay on ERP ALA/assignment rows: the student's private note
// and triage priority. Keyed by the row's stable externalId (erp:assign:{id})
// so the overlay survives every sync upsert (the sync engine never touches
// this table); if the ERP removes and later re-adds the row, the note
// silently reattaches. Never sent back to the ERP.
model AlaNote {
  externalId String   @id
  note       String   @default("")
  priority   Int      @default(0) // 0 = none, 1 = low, 2 = medium, 3 = high
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
